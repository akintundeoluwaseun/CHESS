    "@types/three": "^0.187.0",
    "jest": "^29.7.0",
    "stockfish": "^19.0.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:engine": "node scripts/build-engine-assets.js",
    "build:content": "node scripts/validate-content.js"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-blur"
        ]
      }
    }
  }
